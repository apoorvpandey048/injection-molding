# --- core service config ---
COMPOSE_PROJECT_NAME=imm

# --- MQTT (Mosquitto) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=imm
MQTT_PASSWORD=changeme

# --- TimescaleDB ---
PGHOST=timescaledb
PGPORT=5432
PGUSER=imm
PGPASSWORD=changeme
PGDATABASE=imm

# --- MinIO (S3-compatible blob store) ---
MINIO_ROOT_USER=imm
MINIO_ROOT_PASSWORD=changeme123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_CURVES=curves

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_ARTIFACT_BUCKET=mlflow

# --- API gateway ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=changeme-dev-only

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
