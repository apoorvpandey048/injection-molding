# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.local
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- node ---
node_modules/
.next/
out/
dist/
build/

# --- data / artifacts ---
# Anchored to the repo root so it does NOT match source dirs like
# workbench/src/data/ (the live-data layer).
/data/
ml/datasets/
*.parquet
*.h5
mlruns/
# Ignore artifacts EXCEPT the trained models — committed so a DGX clone needs no
# retraining (deterministic boot; see DEPLOYMENT.md).
/artifacts/*
!/artifacts/models/
/artifacts/models/*
!/artifacts/models/*.pkl
!/artifacts/models/*.md

# --- tunnel (cloudflared quick tunnel for remote demos) ---
/bin/
cloudflared.log

# --- heavy / non-essential (not needed to clone & run; regenerated or local-only) ---
archive.zip
500.zip
research-papers/

# --- OS / IDE ---
.DS_Store
.idea/
.vscode/
*.swp
~$*
